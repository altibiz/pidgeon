    {
      "type": "stat",
      "title": "Throttling",
      "description": "From the firmware throttled flags: low bits are active now, high bits mean it happened since boot.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pidgeon-db"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "None",
                  "color": "#0ca30c",
                  "index": 0
                },
                "1": {
                  "text": "Since boot",
                  "color": "#fab219",
                  "index": 1
                },
                "2": {
                  "text": "Active",
                  "color": "#d03b3b",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pidgeon-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case when throttled_flags is null then null when (throttled_flags & 15) <> 0 then 2 when throttled_flags <> 0 then 1 else 0 end as \"Throttling\"\nfrom system_health\norder by timestamp desc\nlimit 1"
        }
      ]
    },
