    {
      "type": "stat",
      "title": "Unpushed measurements",
      "description": "Measurements stored after the last successful push.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pidgeon-db"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pidgeon-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  (select coalesce(max(id), 0) from measurements)\n  - coalesce((\n    select last\n    from logs\n    where kind = 'push' and status = 'success' and last is not null\n    order by timestamp desc\n    limit 1\n  ), 0) as \"Unpushed measurements\""
        }
      ]
    },
    {
      "type": "table",
      "title": "Devices",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pidgeon-db"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "healthy": {
                        "text": "Healthy",
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "unreachable": {
                        "text": "Unreachable",
                        "color": "#fab219",
                        "index": 1
                      },
                      "inactive": {
                        "text": "Inactive",
                        "color": "#d03b3b",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Last (seen|pinged)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        },
        "sortBy": [
          {
            "displayName": "Device",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pidgeon-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  id as \"Device\",\n  kind as \"Kind\",\n  status::text as \"Status\",\n  coalesce(host(address), path) as \"Endpoint\",\n  slave as \"Slave\",\n  seen as \"Last seen\",\n  pinged as \"Last pinged\"\nfrom devices\norder by id"
        }
      ]
    },
    {
      "type": "state-timeline",
      "title": "Device status",
      "description": "Worst status per interval, written by the ping process.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pidgeon-db"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e8e8e"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "Healthy",
                  "color": "#0ca30c",
                  "index": 0
                },
                "1": {
                  "text": "Unreachable",
                  "color": "#fab219",
                  "index": 1
                },
                "0": {
                  "text": "Inactive",
                  "color": "#d03b3b",
                  "index": 2
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pidgeon-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select\n  $__timeGroupAlias(timestamp, $__interval),\n  source as metric,\n  min(case status when 'healthy' then 2 when 'unreachable' then 1 else 0 end) as value\nfrom health\nwhere $__timeFilter(timestamp)\ngroup by 1, source\norder by 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pushes",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pidgeon-db"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 90,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 8,
            "lineInterpolation": "linear",
            "spanNulls": false,
            "barAlignment": 0,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0ca30c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pidgeon-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select\n  $__timeGroupAlias(timestamp, $__interval, 0),\n  count(*) filter (where status = 'success') as \"Succeeded\",\n  count(*) filter (where status = 'failure') as \"Failed\"\nfrom logs\nwhere $__timeFilter(timestamp) and kind = 'push'\ngroup by 1\norder by 1"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent failures",
      "datasource": {
        "type": "grafana-postgresql-datasource",
