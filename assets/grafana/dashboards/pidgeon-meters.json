      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pidgeon-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select (data->>'activePowerL1NetT0_W')::float8 + (data->>'activePowerL2NetT0_W')::float8 + (data->>'activePowerL3NetT0_W')::float8 as \"Active power\"\nfrom measurements\nwhere source in ($device) and $__timeFilter(timestamp)\norder by timestamp desc\nlimit 1"
        }
      ]
    },
